\_codedecl \_turtle_loaded {Turtle graphics for OpTeX <2026-08-20>}

\_namespace{turtle}

\_def\.vecx#1{\_ea\.vecxA#1}
\_def\.vecxA#1 #2 {#1}
\_def\.vecy#1{\_ea\.vecyA#1}
\_def\.vecyA#1 #2 {#2}
\_def\.scalev#1#2{\expr{#1*\.vecx#2} \expr{#1*\.vecy#2} }
\_def\.sumv#1#2{\expr{\.vecx#1+\.vecx#2} \expr{\.vecy#1+\.vecy#2} }
\_def\.dir{\_cos{\.angle} \_sin{\.angle} }

\_def\.strokeoperator{S}
\_def\.penup{%
   \_def\.moveoperator{m}%
   \_pdfliteral{\.strokeoperator}}
\_def\.pendown{%
   \_def\.moveoperator{l}%
   \_pdfliteral{\.vecx\.pos\_space\.vecy\.pos\_space m}}
\_def\.pencap#1{\_pdfliteral{#1 j #1 J}}
\_def\.pensize#1 {\_pdfliteral{#1 w}}

\_def\.drawsegment#1#2{%
   \_pdfliteral {#1 #2 \.moveoperator}}

\_def\.forward#1 {%
   \_let\.startpos\.pos
   \_edef\.pos{\.sumv\.pos{\.scalev{#1}\.dir}}%
   \.drawsegment
      {\.vecx\.pos}
      {\.vecy\.pos}}
\_def\.left#1 {\_edef\.angle{\_expr{\.angle+#1}}}
\_def\.back#1 {\.forward -(#1) }
\_def\.right#1 {\.left -(#1) }

\_def\.bturtle{\_vbox\_bgroup
   \_let\forward\.forward
   \_let\back\.back
   \_let\right\.right
   \_let\left\.left
   \_let\penup\.penup
   \_let\pendown\.pendown
   \_let\pensize\.pensize
   \_def\squarepen{\.pencap{0}}%
   \_def\roundpen{\.pencap{1}}%
   \_def\projectingpen{\.pencap{2}}%
   \_def\.pos{0 0 }%
   \_def\.angle{90}%
   \roundpen
   \pensize 1 
   \pendown
}
\_def\.eturtle{%
   \.penup
   \_egroup
}

\_nspublic \bturtle \eturtle ;

\_endnamespace
\_endcode