\_codedecl \_turtle_loaded {Turtle graphics for OpTeX <2026-08-20>}

\_namespace{turtle}

\_def\.vecx#1{\_ea\.vecxA#1}
\_def\.vecxA#1 #2 {#1}
\_def\.vecy#1{\_ea\.vecyA#1}
\_def\.vecyA#1 #2 {#2}
\_def\.scalev#1#2{\expr{#1*\.vecx#2} \expr{#1*\.vecy#2} }
\_def\.sumv#1#2{\expr{\.vecx#1+\.vecx#2} \expr{\.vecy#1+\.vecy#2} }
\_def\.dir{\_cos{\.angle} \_sin{\.angle} }

\_newifi\_ifturtle_pendown
\_def\.penup{\_turtle_pendownfalse}
\_def\.pendown{\_turtle_pendowntrue}
\_def\.pensize#1 {\_edef\.pensizevalue{#1}}

\_def\.drawsegment#1#2#3#4#5{%
   \_pdfliteral {q \.pencapvalue\_space J #5 w #1 #2 m #3 #4 l S Q}}

\_def\.forward#1 {%
   \_let\.startpos\.pos
   \_edef\.pos{\.sumv\.pos{\.scalev{#1}\.dir}}%
   \_ifturtle_pendown
      \.drawsegment
         {\.vecx\.startpos}
         {\.vecy\.startpos}
         {\.vecx\.pos}
         {\.vecy\.pos}
         {\.pensizevalue}%
   \_fi
}
\_def\.left#1 {\_edef\.angle{\_expr{\.angle+#1}}}
\_def\.back#1 {\.forward -(#1) }
\_def\.right#1 {\.left -(#1) }
\_def\.repeat#1 #2{\_fornum 1..#1 \_do{#2}}

\_def\.begturtle{\_begingroup
   \_let\forward\.forward
   \_let\back\.back
   \_let\right\.right
   \_let\left\.left
   \_let\penup\.penup
   \_let\pendown\.pendown
   \_let\pensize\.pensize
   \_let\repeat\.repeat
   \_def\squarepen{\def\.pencapvalue{0}}
   \_def\roundpen{\def\.pencapvalue{1}}
   \_def\projectingpen{\def\.pencapvalue{2}}
   \_def\.pos{0 0 }
   \_def\.angle{90}
   \pendown
   \roundpen
   \pensize 0.5 
}
\_def\.endturtle{\_endgroup}

\_nspublic \begturtle \endturtle ;

\_endnamespace
\_endcode